# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Agent workspaces are personal, never part of a submission
.claude/
.codex/
.cursor/
.gemini/

# docs/ is default-deny. Only student-facing files are tracked. TA notes and
# specs live beside them untracked and survive checkouts.
/docs/*
!/docs/REPORT.md
!/docs/SUBMISSION.md
!/docs/template.typ
!/docs/dark-modern.tmTheme

# Group record, written by the agent on the first session. Untracked so it
# survives every checkout and never reaches a remote.
/GROUP.md

# Build output. PDFs are uploaded to Canvas, never committed. Word templates
# are generated by the TA tooling for Canvas and stay local.
*.pdf
*.docx

# Captured video and raw data stay local; only result images are committed
*.mp4
*.mov
*.avi
*.mkv

# OS
.DS_Store
Thumbs.db
